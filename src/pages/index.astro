---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EditorialArtwork from '../components/EditorialArtwork.astro';
import { categories, formatHindiDate, getCategory } from '../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const prayers = (await getCollection('prayers', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'hi'));
const kindLabels = { aarti: 'आरती', chalisa: 'चालीसा', stotra: 'स्तोत्र' } as const;
const previewPrayers = (['chalisa', 'aarti', 'stotra'] as const)
  .map((kind) => prayers.find((item) => item.data.kind === kind))
  .filter((item) => item !== undefined);
const featured = articles.find((item) => item.data.featured) ?? articles[0];
const recent = articles.filter((item) => item.id !== featured?.id).slice(0, 6);
const featuredCategory = featured && getCategory(featured.data.category);
---

<BaseLayout>
  <div class="container">
    <section class="introduction editorial-intro" aria-label="सूत्रपत्र परिचय">
      <div class="intro-copy">
        <span class="section-kicker"><span class="red-dot"></span> स्वतंत्र हिंदी डिजिटल पत्रिका</span>
        <h1>हर जानकारी के पीछे <em>एक कहानी</em> है।</h1>
        <p>भारत की परंपराओं, आस्थाओं और रोज़मर्रा के सवालों को समझिए — स्पष्ट भाषा, संदर्भ और नई दृष्टि के साथ।</p>
        <div class="intro-actions">
          <a class="intro-primary" href="/lekh/">नवीन लेख पढ़ें <span aria-hidden="true">↗</span></a>
          <a class="intro-secondary" href="/paath/">भक्ति पाठ संग्रह <span aria-hidden="true">←</span></a>
        </div>
        <div class="intro-note"><span class="intro-note-rule"></span> विचार · संस्कृति · परंपरा</div>
      </div>
      <div class="intro-visual">
        <div class="intro-visual-cover">
          <EditorialArtwork category="dharm-sanskriti" slug="surya-upasana" format="intro" />
          <span class="intro-visual-overprint">पढ़िए।<br />समझिए।<br /><em>खोजिए।</em></span>
        </div>
        <span class="intro-visual-side">SUTRAPATRA / HINDI EDITORIAL</span>
      </div>
    </section>
    <div class="rule-with-label"><span>संपादक की पसंद</span></div>
    {featured ? (
      <section class="lead-grid" aria-label="प्रमुख लेख">
        <a href={'/lekh/' + featured.id + '/'} class="lead-art-link" aria-label={featured.data.title}>
          <EditorialArtwork category={featured.data.category} slug={featured.id} format="lead" />
        </a>
        <div class="lead-copy">
          <a class="eyebrow" href={'/vishay/' + featured.data.category + '/'}>{featuredCategory?.label}</a>
          <h2><a href={'/lekh/' + featured.id + '/'}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <div class="byline"><time datetime={featured.data.date.toISOString()}>{formatHindiDate(featured.data.date)}</time><span aria-hidden="true">·</span><span>{featured.data.author}</span></div>
          <a class="read-more" href={'/lekh/' + featured.id + '/'}>पूरा लेख पढ़ें <span aria-hidden="true">←</span></a>
        </div>
      </section>
    ) : (
      <section class="empty-notice"><h2>सूत्रपत्र में आपका स्वागत है</h2><p>हम स्वतंत्र और उपयोगी हिंदी सामग्री प्रकाशित करने की तैयारी कर रहे हैं।</p></section>
    )}
    {prayers.length > 0 && (
      <section class="prayer-home-section" aria-labelledby="prayer-title">
        <div class="section-heading">
          <div><span class="section-kicker">भक्ति पाठ संग्रह</span><h2 id="prayer-title">आरती, चालीसा और स्तोत्र का मूल पाठ</h2></div>
          <a class="all-articles-link" href="/paath/">सभी पाठ देखें <span aria-hidden="true">←</span></a>
        </div>
        <div class="prayer-list-grid">
          {previewPrayers.map((prayer) => (
            <a class="prayer-preview-card" href={'/paath/' + prayer.id + '/'}>
              <span class="prayer-card-type">{kindLabels[prayer.data.kind]} · {prayer.data.deity}</span>
              <strong>{prayer.data.title}</strong>
              <span class="prayer-card-action">संपूर्ण पाठ पढ़ें <span aria-hidden="true">←</span></span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="home-section" aria-labelledby="recent-title">
      <div class="section-heading"><div><span class="section-kicker">नई प्रस्तुतियाँ</span><h2 id="recent-title">नवीन लेख</h2></div><a class="all-articles-link" href="/lekh/">सभी लेख देखें <span aria-hidden="true">←</span></a></div>
      <div class="cards-grid">
        {(recent.length ? recent : articles).map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
    <section class="category-section" aria-labelledby="topics-title">
      <div class="section-heading"><div><span class="section-kicker">अपनी रुचि के अनुसार</span><h2 id="topics-title">विषय खोजें</h2></div></div>
      <div class="category-grid">
        {categories.map((category, index) => (
          <a class:list={['category-tile', 'category-' + index]} href={'/vishay/' + category.slug + '/'}>
            <span class="category-symbol" aria-hidden="true">{category.letter}</span>
            <span class="category-content"><strong>{category.label}</strong><small>{category.description}</small><span class="category-cta">लेख देखें <span aria-hidden="true">←</span></span></span>
          </a>
        ))}
      </div>
    </section>
    <section class="mission-band">
      <div><span class="section-kicker">हमारा उद्देश्य</span><h2>सिर्फ जानकारी नहीं, <span>बेहतर समझ।</span></h2></div>
      <p>सूत्रपत्र की शुरुआत एक सरल विचार से हुई है: हिंदी में ऐसे लेख हों जो स्पष्ट, उपयोगी और संदर्भ के प्रति सजग हों। <a href="/hamare-bare-mein/">हमारे बारे में जानें ←</a></p>
    </section>
  </div>
</BaseLayout>

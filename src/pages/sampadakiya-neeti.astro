import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="संपादकीय नीति" description="सूत्रपत्र की तथ्य-जाँच, मूल लेखन, संशोधन और विज्ञापन संबंधी संपादकीय नीति।">
  <div class="container content-page">
    <div class="breadcrumbs"><a href="/">मुखपृष्ठ</a><span aria-hidden="true">/</span><span>संपादकीय नीति</span></div>
    <span class="section-kicker">विश्वसनीय जानकारी</span>
    <h1>संपादकीय नीति</h1>
    <p>सूत्रपत्र का लक्ष्य उपयोगी और स्पष्ट हिंदी सामग्री तैयार करना है। यह पृष्ठ हमारे शुरुआती संपादकीय सिद्धांतों को बताता है।</p>
    <h2>तथ्य और संदर्भ</h2>
    <p>तिथि, स्थान, व्यक्ति, ऐतिहासिक घटना और वैज्ञानिक अथवा कानूनी दावे जैसे सत्यापन योग्य विवरण यथासंभव भरोसेमंद स्रोतों से जाँचे जाने चाहिए। धार्मिक या सांस्कृतिक परंपराओं के विषय में अलग-अलग मान्यताओं को तथ्य के रूप में एक-दूसरे पर नहीं थोपा जाएगा।</p>
    <h2>मौलिकता और कॉपीराइट</h2>
    <p>किसी अन्य प्रकाशक की सामग्री को बिना उचित अनुमति के कॉपी कर प्रकाशित नहीं किया जाएगा। उद्धरण और सार्वजनिक स्रोतों के उपयोग में लागू कॉपीराइट नियमों का ध्यान रखा जाएगा।</p>
    <h2>संशोधन और पारदर्शिता</h2>
    <p>किसी लेख में महत्त्वपूर्ण गलती मिलने पर उसे सुधारा जाएगा; जहाँ उचित हो, लेख पर संशोधन तिथि भी दर्शाई जाएगी। कुछ प्रारूपों में AI-आधारित लेखन या अनुसंधान सहायता का उपयोग किया जा सकता है। ऐसी सहायता को स्वतः मानवीय तथ्य-जाँच या विशेषज्ञ समीक्षा नहीं माना जाता। वेबसाइट संचालक को महत्त्वपूर्ण तथ्य, स्रोत, लेखक-नाम और संवेदनशील विषयों की अंतिम समीक्षा करनी होगी। आवश्यक सुधारों को अद्यतन तिथि के साथ दर्शाया जाएगा।</p>
    <h2>विज्ञापन</h2>
    <p>शुरुआती संस्करण में भुगतान किए गए विज्ञापन शामिल नहीं हैं। भविष्य में कोई प्रायोजित सामग्री प्रकाशित होने पर उसकी प्रकृति स्पष्ट रूप से बताई जाएगी।</p>
  </div>
</BaseLayout>

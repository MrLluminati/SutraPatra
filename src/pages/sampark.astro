---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="संपर्क" description="सूत्रपत्र से संपर्क और संपादकीय सुझाव भेजने के बारे में जानकारी।">
  <div class="container content-page">
    <div class="breadcrumbs"><a href="/">मुखपृष्ठ</a><span aria-hidden="true">/</span><span>संपर्क</span></div>
    <span class="section-kicker">संपर्क</span>
    <h1>हमसे संपर्क करें</h1>
    <p>पाठकों के सुझाव, सामग्री में सुधार और संपादकीय प्रश्न हमारे लिए महत्त्वपूर्ण हैं। आधिकारिक संपर्क ईमेल प्रकाशन के सार्वजनिक लॉन्च से पहले यहाँ जोड़ा जाएगा।</p>
    <p>फिलहाल इस पृष्ठ पर कोई संपर्क फ़ॉर्म या संदेश-संग्रह सेवा सक्रिय नहीं है। कृपया इस वेबसाइट पर निजी या संवेदनशील जानकारी प्रकाशित न करें।</p>
  </div>
</BaseLayout>

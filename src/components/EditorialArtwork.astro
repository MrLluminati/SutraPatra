---
interface Props {
  category: string;
  slug?: string;
  format?: 'card' | 'lead' | 'article' | 'intro';
}
const { category, slug = 'panchang', format = 'card' } = Astro.props;
const motif =
  /amavasya|purnima|chandra/.test(slug) ? 'moon' :
  /surya|aditya|chhath|sankranti/.test(slug) ? 'sun' :
  /panchang|tithi|nakshatra/.test(slug) ? 'calendar' :
  /hanuman|aarti|stotra|chalisa/.test(slug) ? 'book' : 'lotus';
const categories: Record<string, string> = {
  'dharm-sanskriti': 'संस्कृति एवं परंपरा',
  'aarti-stotra': 'भक्ति एवं वाङ्मय',
  'vrat-tyohar': 'पर्व एवं पंचांग',
};
const rays = Array.from({ length: 16 }, (_, i) => i * 22.5);
---
<div class:list={['editorial-artwork', 'artwork-' + format, 'artwork-' + category]} aria-hidden="true">
  <span class="artwork-edition">सूत्रपत्र <span class="artwork-edition-rule"></span> ORIGINAL STORIES</span>
  <svg viewBox="0 0 600 430" role="presentation" focusable="false" class="artwork-svg" xmlns="http://www.w3.org/2000/svg">
    <g class="artwork-ornament" stroke="currentColor" stroke-width="1.35" fill="none">
      <rect x="38" y="30" width="524" height="370" rx="160" opacity=".32"/>
      <rect x="59" y="49" width="482" height="334" rx="144" opacity=".21"/>
      <circle cx="300" cy="215" r="136" opacity=".37" stroke-dasharray="2 10"/>
      <circle cx="300" cy="215" r="111" opacity=".52"/>
      <circle cx="300" cy="215" r="101" opacity=".31"/>
      {rays.map((angle) => (
        <path transform={'rotate(' + angle + ' 300 215)'} d="M300 64v16 M300 92v5" opacity=".5" stroke-linecap="round"/>
      ))}
      <path d="M86 84h47 M467 84h47 M86 346h47 M467 346h47" opacity=".62"/>
      <path d="M300 54l7 7-7 7-7-7z M300 362l7 7-7 7-7-7z M76 215l7 7-7 7-7-7z M524 215l7 7-7 7-7-7z" opacity=".65"/>
      <path d="M138 215h-28 M462 215h28" opacity=".38"/>
    </g>
    <g class="artwork-focus" stroke="currentColor" fill="none" stroke-linejoin="round" stroke-linecap="round">
      {motif === 'sun' && (
        <>
          <circle cx="300" cy="215" r="49" fill="currentColor" fill-opacity=".13" stroke-width="2"/>
          <circle cx="300" cy="215" r="35" stroke-width="2"/>
          {rays.slice(0,12).map((angle) => (
            <path transform={'rotate(' + angle * 1.5 + ' 300 215)'} d="M300 147v15" stroke-width="3"/>
          ))}
          <path d="M278 215h44 M300 193v44" stroke-width="1" opacity=".35"/>
        </>
      )}
      {motif === 'moon' && (
        <>
          <path d="M332 148A75 75 0 1 0 359 273A70 70 0 0 1 332 148Z" fill="currentColor" fill-opacity=".16" stroke-width="2"/>
          <path d="M366 155l5 12 12 5-12 5-5 12-5-12-12-5 12-5z M388 230l4 8 8 4-8 4-4 8-4-8-8-4 8-4z" fill="currentColor" fill-opacity=".4" stroke-width="1"/>
          <circle cx="363" cy="221" r="3" fill="currentColor"/>
        </>
      )}
      {motif === 'calendar' && (
        <>
          <rect x="247" y="165" width="106" height="104" rx="6" stroke-width="2.5"/>
          <path d="M247 194h106 M274 154v23 M326 154v23" stroke-width="2.5"/>
          <path d="M268 214h16 M295 214h16 M324 214h11 M268 235h16 M295 235h16" stroke-width="2.5" opacity=".75"/>
          <circle cx="327" cy="236" r="7" fill="currentColor" fill-opacity=".36" stroke-width="1"/>
        </>
      )}
      {motif === 'book' && (
        <>
          <path d="M300 262c-26-16-54-19-89-17v-76c36-3 62 2 89 19 27-17 53-22 89-19v76c-35-2-63 1-89 17Z" fill="currentColor" fill-opacity=".11" stroke-width="2.5"/>
          <path d="M300 188v74 M224 187c23-1 44 2 62 12 M315 199c18-10 39-13 62-12 M224 212c23-1 44 2 62 12 M315 224c18-10 39-13 62-12" stroke-width="1.5" opacity=".78"/>
          <path d="M210 253c40-2 64 5 90 19 26-14 50-21 90-19" stroke-width="2"/>
        </>
      )}
      {motif === 'lotus' && (
        <>
          <path d="M300 260c-45-32-41-79 0-107 41 28 45 75 0 107Z M300 260c-54 0-81-28-84-67 44-6 75 16 84 67Z M300 260c54 0 81-28 84-67-44-6-75 16-84 67Z" stroke-width="2" fill="currentColor" fill-opacity=".08"/>
          <path d="M300 260v-79 M248 267h104 M259 279h82" stroke-width="2" />
        </>
      )}
    </g>
  </svg>
  <span class="artwork-caption"><span class="artwork-caption-line"></span>{categories[category] ?? 'सूत्रपत्र'}</span>
</div>

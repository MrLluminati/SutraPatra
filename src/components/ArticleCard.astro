---
import type { CollectionEntry } from 'astro:content';
import { formatHindiDate, getCategory } from '../lib/site';
import EditorialArtwork from './EditorialArtwork.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  compact?: boolean;
}

const { article, compact = false } = Astro.props;
const category = getCategory(article.data.category);
const articleUrl = '/lekh/' + article.id + '/';
---

<article class:list={['article-card', { compact }]}>
  <a class="article-art-link" href={articleUrl} aria-label={article.data.title}>
    <EditorialArtwork category={article.data.category} slug={article.id} format="card" />
  </a>
  <div class="article-card-body">
    <a class="eyebrow" href={'/vishay/' + article.data.category + '/'}>{category?.label}</a>
    <h3><a href={articleUrl}>{article.data.title}</a></h3>
    {!compact && <p class="card-description">{article.data.description}</p>}
    <div class="byline"><time datetime={article.data.date.toISOString()}>{formatHindiDate(article.data.date)}</time><span aria-hidden="true">·</span><span>{article.data.author}</span></div>
  </div>
</article>
